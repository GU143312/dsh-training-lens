{
  "name": "dsh-training-lens",
  "version": "0.3.0",
  "description": "Training Lens · 训练视窗 — a local, read-only TensorBoard scalar dashboard for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./dist/client.js",
    "./typert": "./src/wire.js",
    "./remote": "./src/wire.js"
  },
  "files": [
    "src/*.js",
    "dist/client.js",
    "python/server.py",
    "python/web/*.js",
    "python/web/*.html",
    "python/web/*.css",
    "cordis.patch.yml",
    "requirements.txt",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "GU143312",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tensorboard",
    "training",
    "monitoring",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GU143312/dsh-training-lens.git"
  },
  "homepage": "https://github.com/GU143312/dsh-training-lens#readme",
  "bugs": {
    "url": "https://github.com/GU143312/dsh-training-lens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "esbuild": "0.25.12",
    "prettier": "3.6.2"
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-package.js",
    "prepack": "npm run build && npm run check && npm test"
  }
}
